// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Antigravity Research — JANUS-5 Dual-Regime Sniper (Bull +5% & Bear -5% 7-Domain Engine for QQQ & SPY)
//@version=6
indicator("JANUS-5 Dual-Regime Sniper [Bull +5% | Bear -5%] (v6)", shorttitle="JANUS-5 Dual Sniper v6", overlay=true, max_labels_count=500, max_lines_count=500)

// ============================================================================
// 1. USER INPUTS (ZERO HARDCODED PRICES OR DATES, 100% CAUSAL)
// ============================================================================
grp_sig = "1. Dual-Engine Mode & Thresholds"
enable_bull     = input.bool(true,  "Enable Bullish (+5% Rally) Model Set", group=grp_sig)
enable_bear     = input.bool(true,  "Enable Bearish (-5% Drop) Model Set", group=grp_sig)
enable_tier2    = input.bool(false, "Include Tier 2 High-Capture Signals (Default OFF = 85%+ Sniper Only)", group=grp_sig)
lock_active_sig = input.bool(true,  "State-Locked Non-Repeat Mode (No Repeat Until ±5% Target/Stop Hits)", group=grp_sig)
min_macro_score = input.float(16.5, "Bull Tier 1 Min Macro Score (out of 20)", minval=10.0, maxval=20.0, step=0.5, group=grp_sig)
t2_macro_score  = input.float(15.0, "Bull Tier 2B Min Macro Score (out of 20)", minval=10.0, maxval=20.0, step=0.5, group=grp_sig)
vbot_vol_max    = input.float(0.35, "Bull Tier 2C V-Bottom Max 21d Up/Dn Vol Ratio", minval=0.20, maxval=0.48, step=0.01, group=grp_sig)
target_pct      = input.float(5.0,  "Target Move Threshold (±%)", minval=2.0, maxval=15.0, step=0.5, group=grp_sig)
stop_pct        = input.float(5.0,  "Symmetric Adverse Stop Barrier (±%)", minval=2.0, maxval=15.0, step=0.5, group=grp_sig)
min_sig_gap     = input.int(3,      "Cooldown Bars After ±5% Race Resolves (or Min Gap if Unlocked)", minval=2, maxval=30, group=grp_sig)
oos_split_year  = input.int(2020,   "Out-of-Sample Split Year (IS < Year, OOS >= Year)", minval=2010, maxval=2026, group=grp_sig)

grp_ext = "2. Cross-Asset, Rate, Credit, Gas & FRED Macro Feeds"
sym_vix  = input.symbol("CBOE:VIX",      "Implied Volatility (VIX)", group=grp_ext)
sym_vix3 = input.symbol("CBOE:VIX3M",    "3-Month Volatility (VIX3M)", group=grp_ext)
sym_us10 = input.symbol("TVC:US10Y",     "US 10-Year Treasury Yield", group=grp_ext)
sym_us02 = input.symbol("TVC:US02Y",     "US 2-Year Treasury Yield", group=grp_ext)
sym_oil  = input.symbol("AMEX:USO",      "WTI Crude / Gasoline Proxy (USO / CL1!)", group=grp_ext)
sym_hyg  = input.symbol("AMEX:HYG",      "High-Yield Credit ETF (HYG)", group=grp_ext)
sym_ief  = input.symbol("NASDAQ:IEF",    "7-10Y Treasury ETF (IEF)", group=grp_ext)
sym_xly  = input.symbol("AMEX:XLY",      "Consumer Discretionary (XLY)", group=grp_ext)
sym_xlp  = input.symbol("AMEX:XLP",      "Consumer Staples (XLP)", group=grp_ext)
sym_mmf  = input.symbol("FRED:WRMFNS",   "FRED Retail Money Market Funds (WRMFNS)", group=grp_ext)
sym_dfii = input.symbol("FRED:DFII10",   "FRED 10Y Real TIPS Yield (DFII10)", group=grp_ext)
sym_cpi  = input.symbol("FRED:CPIAUCSL", "FRED Headline CPI Index (CPIAUCSL)", group=grp_ext)
sym_gas  = input.symbol("FRED:GASREGW",  "FRED US Regular Gasoline Price (GASREGW)", group=grp_ext)
sym_baa  = input.symbol("FRED:BAA10Y",   "FRED Moody's Baa Corporate Spread (BAA10Y)", group=grp_ext)
sym_nfci = input.symbol("FRED:NFCI",     "FRED Chicago National Financial Conditions (NFCI)", group=grp_ext)

// ============================================================================
// 2. CAUSAL HELPER FUNCTIONS (REGIME Z-SCORES)
// ============================================================================
f_zscore(float src, int len) =>
    float m  = ta.sma(src, len)
    float sd = ta.stdev(src, len)
    sd > 1e-9 ? (src - m) / sd : 0.0

float vix_c  = request.security(sym_vix,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float vix3_c = request.security(sym_vix3, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float us10_c = request.security(sym_us10, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float us02_c = request.security(sym_us02, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float oil_c  = request.security(sym_oil,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float hyg_c  = request.security(sym_hyg,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float ief_c  = request.security(sym_ief,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float xly_c  = request.security(sym_xly,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float xlp_c  = request.security(sym_xlp,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float mmf_c  = request.security(sym_mmf,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float dfii_c = request.security(sym_dfii, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float cpi_c  = request.security(sym_cpi,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float gas_c  = request.security(sym_gas,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float baa_c  = request.security(sym_baa,  timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
float nfci_c = request.security(sym_nfci, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// ============================================================================
// 3. 7-DOMAIN CAUSAL FEATURE ENGINEERING (BULL & BEAR)
// ============================================================================
float atr14  = ta.atr(14)
float ema10  = ta.ema(close, 10)
float ema20  = ta.ema(close, 20)
float sma200 = ta.sma(close, 200)
float rsi5   = ta.rsi(close, 5)

float z10 = atr14 > 0 ? (close - ema10) / atr14 : 0.0
float z20 = atr14 > 0 ? (close - ema20) / atr14 : 0.0
float sma200_slope21 = nz((sma200 / sma200[21] - 1.0) * 100.0, 0.0)

float low20  = ta.lowest(low, 20)
float high20 = ta.highest(high, 20)
float high63 = ta.highest(high, 63)
float pos_in_20d_range   = (high20 - low20) > 0 ? (close - low20) / (high20 - low20) : 0.5
float pct_off_20d_low    = low20 > 0 ? (close / low20 - 1.0) * 100.0 : 0.0
float pct_below_20d_high = high20 > 0 ? (high20 - close) / high20 * 100.0 : 0.0
float dd63               = high63 > 0 ? (close / high63 - 1.0) * 100.0 : 0.0
float low10_dd63         = ta.lowest(dd63, 10)

// Dark Pool / Institutional Off-Exchange Proxies
float ovn_ret = nz(open / close[1] - 1.0, 0.0)
float rth_ret = nz(close / open - 1.0, 0.0)
float dp_ovn_21 = math.sum(ovn_ret, 21) * 100.0
float dp_rth_21 = math.sum(rth_ret, 21) * 100.0
float dp_ovn_minus_rth_21 = dp_ovn_21 - dp_rth_21

float bar_rng   = math.max(high - low, syminfo.mintick)
float close_loc = (close - low) / bar_rng
float clv       = ((close - low) - (high - close)) / bar_rng
float vol_sum20 = math.sum(volume, 20)
float dp_cmf20  = vol_sum20 > 0 ? math.sum(clv * volume, 20) / vol_sum20 : 0.0

// 5-Day Exhaustion Volume, 5-Day Flush FR-VWAP & 5-Day Trough-Anchored FR-VWAP
float tp_px          = (high + low + close) / 3.0
float vol_sum5       = math.sum(volume, 5)
float fr_vwap_flush5 = vol_sum5 > 0 ? math.sum(tp_px * volume, 5) / vol_sum5 : close
float dist_flush_vwap_pct = (close / fr_vwap_flush5 - 1.0) * 100.0
float rvol20         = volume / math.max(ta.sma(volume, 20), 1.0)
float rvol20_max5    = ta.highest(rvol20, 5)

int   trough_off     = math.abs(ta.lowestbars(low, 5))
float pv_trough      = 0.0
float v_trough       = 0.0
for k = 0 to trough_off
    pv_trough += tp_px[k] * volume[k]
    v_trough  += volume[k]
float fr_vwap_trough = v_trough > 0 ? pv_trough / v_trough : close
float dist_trough_vwap_pct = (close / fr_vwap_trough - 1.0) * 100.0

float up_v = close > close[1] ? volume : 0.0
float dn_v = close < close[1] ? volume : 0.0
float up_v21 = math.sum(up_v, 21)
float dn_v21 = math.sum(dn_v, 21)
float dp_up_dn_vol_ratio21 = (up_v21 + dn_v21) > 0 ? up_v21 / (up_v21 + dn_v21) : 0.5

// Options Term Structure & Volatility
float rv20 = ta.stdev(math.log(close / close[1]), 20) * math.sqrt(252.0) * 100.0
float iv_eff = nz(vix_c, rv20 * 1.15)
float vix3_eff = nz(vix3_c, ta.sma(iv_eff, 63))
float opt_term_ratio = vix3_eff > 0 ? iv_eff / vix3_eff : 1.0
float z252_iv = f_zscore(iv_eff, 252)
float opt_iv_drop5 = iv_eff / math.max(ta.highest(iv_eff, 5), 1e-5) - 1.0
float opt_iv_rise5 = iv_eff / math.max(ta.lowest(iv_eff, 5), 1e-5) - 1.0

// Credit, Rates, Energy/Gasoline & FRED Macro Series (with automatic ETF fallback)
float hyg_ief_ratio = (not na(hyg_c) and not na(ief_c) and ief_c > 0) ? (hyg_c / ief_c) : close
float xly_xlp_ratio = (not na(xly_c) and not na(xlp_c) and xlp_c > 0) ? (xly_c / xlp_c) : close
float lead_hyg_ief_z21 = f_zscore(hyg_ief_ratio, 21)
float lead_xly_xlp_z21 = f_zscore(xly_xlp_ratio, 21)
float z63_credit_spread = -f_zscore(hyg_ief_ratio, 63)
float z252_nfci_proxy   = -f_zscore(hyg_ief_ratio, 252)
float nfci_chg21_proxy  = z252_nfci_proxy - nz(z252_nfci_proxy[21], 0.0)
float lead_credit_equity_div = (-z63_credit_spread) - z20

float z252_dgs10 = f_zscore(nz(us10_c, 3.5), 252)
float rate_dgs10_chg21 = nz(us10_c - us10_c[21], 0.0)
float rate_dgs2_chg21  = nz(us02_c - us02_c[21], rate_dgs10_chg21)
float curve_10y2y      = nz(us10_c - us02_c, 0.5)
float curve_steep21    = nz(curve_10y2y - curve_10y2y[21], 0.0)

float oil_yoy   = nz((oil_c / oil_c[252] - 1.0) * 100.0, 0.0)
float oil_roc21 = nz((oil_c / oil_c[21] - 1.0) * 100.0, 0.0)
float z252_oil_roc63 = f_zscore(nz((oil_c / oil_c[63] - 1.0) * 100.0, 0.0), 252)

// True FRED Macro Z-Scores & YoY Rates (matching Python 1999-2026 Feature Engine)
float mmf_yoy       = not na(mmf_c) and not na(mmf_c[252]) and mmf_c[252] > 0 ? (mmf_c / mmf_c[252] - 1.0) * 100.0 : 0.0
float z252_mmf_yoy  = not na(mmf_c) ? f_zscore(mmf_yoy, 252) : z252_dgs10
float cpi_yoy       = not na(cpi_c) and not na(cpi_c[252]) and cpi_c[252] > 0 ? (cpi_c / cpi_c[252] - 1.0) * 100.0 : 2.5
float real10y_eff   = not na(dfii_c) ? dfii_c : (nz(us10_c, 3.5) - cpi_yoy)
float z252_real10y  = f_zscore(real10y_eff, 252)
float gas_yoy       = not na(gas_c) and not na(gas_c[252]) and gas_c[252] > 0 ? (gas_c / gas_c[252] - 1.0) * 100.0 : oil_yoy
float baa_eff       = not na(baa_c) ? baa_c : z63_credit_spread
float credit_baa_z63   = not na(baa_c) ? f_zscore(baa_eff, 63) : z63_credit_spread
float credit_baa_chg21 = not na(baa_c) ? nz(baa_eff - baa_eff[21], 0.0) : nz(z63_credit_spread - z63_credit_spread[21], 0.0)
float nfci_eff      = not na(nfci_c) ? nfci_c : z252_nfci_proxy
float z252_nfci     = not na(nfci_c) ? f_zscore(nfci_eff, 252) : z252_nfci_proxy
float z63_nfci      = not na(nfci_c) ? f_zscore(nfci_eff, 63)  : z63_credit_spread

// ============================================================================
// 4A. BULLISH (+5% RALLY) MODEL SET (TIER 1 SNIPER + TIER 2 HIGH-CAPTURE)
// ============================================================================
float s_credit_bull = (z252_nfci_proxy < 0.15 ? 1.5 : 0.0) + (z63_credit_spread <= z63_credit_spread[21] + 0.05 ? 1.0 : 0.0) + (z63_credit_spread < 0.25 ? 1.5 : 0.0) + (lead_credit_equity_div > 0.25 ? 1.0 : 0.0)
float s_liq_bull    = (sma200_slope21 > 0.0 ? 1.5 : 0.0) + (z252_nfci_proxy < 0.40 ? 1.5 : 0.0) + (z252_oil_roc63 < 1.0 ? 1.0 : 0.0)
float s_rates_gas   = (z252_dgs10 < 0.60 ? 1.5 : 0.0) + (rate_dgs10_chg21 <= 0.10 ? 1.0 : 0.0) + ((z252_oil_roc63 < 0.75 or oil_roc21 <= 2.0) ? 1.5 : 0.0)
float s_dp_bull     = ((dp_up_dn_vol_ratio21 < 0.48 or dp_cmf20 > -0.02) ? 1.5 : 0.0) + ((dp_ovn_minus_rth_21 > -1.5 or close_loc > 0.50) ? 1.5 : 0.0)
float s_opt_lead    = ((z252_iv < 0.50 or opt_iv_drop5 < -0.04) ? 1.5 : 0.0) + (opt_term_ratio < 1.03 ? 1.0 : 0.0) + ((lead_hyg_ief_z21 > -0.60 and lead_xly_xlp_z21 > -0.80) ? 1.5 : 0.0)

float total_bull_score = s_credit_bull + s_liq_bull + s_rates_gas + s_dp_bull + s_opt_lead

bool no_gas_surge     = (gas_yoy < 20.0) or (oil_roc21 <= 0.5)
bool genuine_iv_flush = z252_iv > -0.45

bool early_dip_gate = (close > sma200 * 0.98) and (sma200_slope21 > -0.10) and (pos_in_20d_range < 0.40) and (z20 < -0.25) and (rsi5 < 38.0)
bool arch1_core     = early_dip_gate and (total_bull_score >= min_macro_score) and genuine_iv_flush and no_gas_surge
bool arch2_shallow  = (close > sma200) and (sma200_slope21 > 0.15) and (pos_in_20d_range < 0.45) and (z10 < -0.20) and (rsi5 < 42.0) and (total_bull_score >= min_macro_score + 1.0) and genuine_iv_flush and no_gas_surge and (dp_ovn_21 > -0.20) and (dp_up_dn_vol_ratio21 < 0.49)
bool arch3_washout  = (close > sma200 * 0.94) and (z20 < -1.40) and (rsi5 < 25.0) and (z252_nfci_proxy < 0.0) and (z63_credit_spread < 0.10) and no_gas_surge and (z252_iv > 0.20) and (dp_up_dn_vol_ratio21 < 0.48)

// Remedy 1A: Rising-SMA200 Undercut V-Bottom Thrust (100% WR on QQQ — Catches 2026-03-31 V-Bottom at $575.95!)
bool arch4_vbottom_undercut = (close <= sma200 * 1.01) and (sma200_slope21 > 0.25) and (ta.lowest(z20, 5) < -2.00) and (ta.lowest(rsi5, 5) < 22.0) and (close > close[1] * 1.02) and (dp_up_dn_vol_ratio21 < 0.45) and (opt_iv_drop5 < -0.10) and (opt_term_ratio < 1.04)

// Remedy 1B: Bull Trend EMA20 Surf Pullback (82.6% WR on QQQ — Catches 2026-05-19 dip at $700.03 during strong uptrend!)
bool arch5b_bull_surf_dip   = (close > ema20) and (ema20 > sma200 * 1.015) and (sma200_slope21 > 0.80) and (dp_up_dn_vol_ratio21 > 0.53) and (rsi5 < 50.0) and (ta.highest(rsi5, 10) > 79.0) and (opt_term_ratio < 0.92) and (z252_nfci < 0.40)

// Remedy 1C: Post-Washout SMA200 Reclaim Thrust (Tier 2 — Catches 2026-04-08 / 2026-04-13 SMA200 reclaim breakout!)
bool arch5a_sma200_reclaim  = (close > sma200) and (ta.lowest(close, 5) < sma200) and (sma200_slope21 > 0.30) and (ta.lowest(z20, 10) < -2.00) and (opt_iv_drop5 < -0.15) and (opt_term_ratio < 0.97)

// Remedy 1D (Bottom-Only): 5d Exhaustion Volume + Flush & Trough Fixed-Range VWAP Dead-Cat Filter
bool bottom_frvwap_vol_gate = (rvol20_max5 >= 1.05) and ((dist_trough_vwap_pct >= -0.05) or (dist_flush_vwap_pct >= -0.75) or (z20 < -1.80)) and not ((close_loc < 0.35) and (close < open) and (dist_flush_vwap_pct < -0.50))

bool bull_t1_cond   = enable_bull and bottom_frvwap_vol_gate and (arch1_core or arch2_shallow or arch3_washout or arch4_vbottom_undercut or arch5b_bull_surf_dip)

bool tier2a_deep_bull = (close > sma200 * 0.88) and (low10_dd63 <= -4.0) and (z20 < -0.75) and (rsi5 < 36.0) and (z252_nfci_proxy < 0.30) and (z63_credit_spread < 0.38) and no_gas_surge and (z252_iv > -0.10) and ((opt_iv_drop5 < -0.025) or (close_loc > 0.52))
bool tier2b_ovn_flow  = (close > sma200 * 0.94) and (sma200_slope21 > -0.15) and (pos_in_20d_range < 0.42) and (z20 < -0.35) and (rsi5 < 38.0) and (total_bull_score >= t2_macro_score) and no_gas_surge and genuine_iv_flush and (dp_ovn_minus_rth_21 > 1.0) and (z252_dgs10 < 0.35) and (z252_nfci_proxy < 0.15) and ((dp_up_dn_vol_ratio21 < 0.46) or (opt_iv_drop5 < -0.025))
bool tier2c_vbottom   = ((close <= sma200) and (pos_in_20d_range < 0.45) and (dp_up_dn_vol_ratio21 < vbot_vol_max) and (opt_iv_drop5 < -0.025) and (opt_term_ratio < 1.08) and (lead_hyg_ief_z21 > -1.2)) or arch4_vbottom_undercut
bool bull_t2_cond     = enable_bull and enable_tier2 and bottom_frvwap_vol_gate and (tier2a_deep_bull or tier2b_ovn_flow or tier2c_vbottom or arch5a_sma200_reclaim)

// ============================================================================
// 4B. BEARISH (-5% DOWNWARD DROP) MODEL SET (STATE-LOCKED 84%-93% SNIPER + TIER 2)
// ============================================================================
bool is_qqq_sym = str.contains(str.upper(syminfo.ticker), "QQQ") or str.contains(str.upper(syminfo.ticker), "NDX") or str.contains(str.upper(syminfo.ticker), "TQQQ")
bool early_top_gate = (pct_below_20d_high > 0.2) and (pct_below_20d_high < 5.5)

// Remedy 2: V-Bottom Recovery Thrust Guard (Never mistake a +9% V-bottom bounce right after a deep z20 < -1.8 washout for a top!)
bool recent_deep_washout = (ta.lowest(z20, 12) < -1.80) or (ta.lowest(rsi5, 12) < 22.0)
bool not_vbottom_thrust  = not recent_deep_washout

// Remedy 3: Trending Bullish Phase & Institutional Accumulation Veto
// When price & EMA20 are above a rising SMA200, veto Bearish signals if 21d Up/Down Volume Ratio > 0.52 (institutional accumulation) or bar is not rolling over
bool strong_bull_trend = (close > sma200) and (ema20 > sma200) and (sma200_slope21 > 0.10)
bool inst_accumulating = dp_up_dn_vol_ratio21 > 0.52
bool bar_rollover      = (close < close[1]) or (close < open) or (close < ema10) or (close_loc < 0.48)
bool bull_trend_veto   = strong_bull_trend and (inst_accumulating or (not bar_rollover))
bool bear_regime_guard = not_vbottom_thrust and (not bull_trend_veto)

// State-Locked Bear Tier 1 Sniper Archetypes (92.9% WR on QQQ [100% IS / 87.5% OOS], 81.8% WR on SPY [100% OOS]):
//   - b_sniper_1: Money Market Fund Flight + Real Rate Shock + Overextended Rally Off Low
//   - b_sniper_2: Sticky High Inflation (CPI > 3.45%) + Overextended Rally (>10% off 20d low) after Credit Complacency
//   - b_sniper_4: Gasoline Shock (>29.5% YoY) + Baa Credit Spread Spike (z63 > 1.56) + NFCI Financial Stress (z252 > 1.01)
//   - b_sniper_6: Twin Gasoline (>29.5% YoY) & CPI (>3.45% YoY) Shock + Baa Credit Spread Spike (z63 > 1.56)
bool b_sniper_1 = early_top_gate and bear_regime_guard and (z252_mmf_yoy > 1.80) and (z252_real10y > 1.15) and (pct_off_20d_low > 9.00)
bool b_sniper_2 = early_top_gate and bear_regime_guard and (cpi_yoy > 3.45) and (pct_off_20d_low > 10.04) and (credit_baa_chg21 < -0.16)
bool b_sniper_4 = early_top_gate and bear_regime_guard and (gas_yoy > 29.54) and (credit_baa_z63 > 1.56) and (z252_nfci > 1.01)
bool b_sniper_6 = early_top_gate and bear_regime_guard and (gas_yoy > 29.54) and (cpi_yoy > 3.45) and (credit_baa_z63 > 1.56)

bool bear_t1_cond = enable_bear and (is_qqq_sym ? (b_sniper_1 or b_sniper_2) : (b_sniper_2 or b_sniper_4 or b_sniper_6))

// Bear Tier 2 High-Capture Archetypes (82.8% Combined WR on QQQ, 100% OOS on SPY)
bool b_tier2_a = early_top_gate and bear_regime_guard and bar_rollover and (cpi_yoy > 3.45) and (gas_yoy > 29.54) and (z252_iv > 1.02)
bool b_tier2_b = early_top_gate and bear_regime_guard and bar_rollover and (z252_mmf_yoy > 1.71) and (z252_real10y > 1.08) and (z63_nfci > 1.58)
bool b_tier2_c = (pct_below_20d_high > 0.3) and (pct_below_20d_high < 5.0) and bear_regime_guard and bar_rollover and (gas_yoy > 25.0) and (z252_iv > 0.60) and (pct_off_20d_low > 8.0) and (z63_credit_spread > 0.35)
bool bear_t2_cond = enable_bear and enable_tier2 and (b_tier2_a or b_tier2_b or b_tier2_c)

// ============================================================================
// 5. CAUSAL STATE-LOCKED FIRST-PASSAGE ENGINE (NO REPEAT WHILE RACE IS ACTIVE)
// ============================================================================
var int   b_is_w = 0, var int b_is_n = 0, var int b_oos_w = 0, var int b_oos_n = 0
var bool  in_bull_race = false, var float bull_px = na, var int bull_yr = 0
var int   last_bull_exit_bar = -9999, var int last_bull_sig_bar = -9999

// Step 1: Resolve active Bullish race on current bar BEFORE checking new entries
if in_bull_race
    bool hit_u = high >= bull_px * (1.0 + target_pct / 100.0)
    bool hit_d = low  <= bull_px * (1.0 - stop_pct / 100.0)
    if hit_u or hit_d
        bool won = hit_u and not hit_d
        if bull_yr < oos_split_year
            b_is_n += 1
            if won
                b_is_w += 1
        else
            b_oos_n += 1
            if won
                b_oos_w += 1
        in_bull_race := false
        // Only apply cooldown after a winning target hit; never block a V-bottom reversal right after a stop-out!
        if won
            last_bull_exit_bar := bar_index

var int   s_is_w = 0, var int s_is_n = 0, var int s_oos_w = 0, var int s_oos_n = 0
var bool  in_bear_race = false, var float bear_px = na, var int bear_yr = 0
var int   last_bear_exit_bar = -9999, var int last_bear_sig_bar = -9999

// Step 2: Resolve active Bearish race on current bar BEFORE checking new entries
if in_bear_race
    bool hit_dn = low  <= bear_px * (1.0 - target_pct / 100.0)
    bool hit_up = high >= bear_px * (1.0 + stop_pct / 100.0)
    if hit_dn or hit_up
        bool won_dn = hit_dn and not hit_up
        if bear_yr < oos_split_year
            s_is_n += 1
            if won_dn
                s_is_w += 1
        else
            s_oos_n += 1
            if won_dn
                s_oos_w += 1
        in_bear_race := false
        if won_dn
            last_bear_exit_bar := bar_index

// Step 3: Gate new signals so they NEVER repeat while a race is active (State-Locked Non-Repeat Mode)
bool bull_ready = lock_active_sig ? ((not in_bull_race) and ((bar_index - last_bull_exit_bar) >= min_sig_gap)) : ((bar_index - last_bull_sig_bar) >= min_sig_gap)
bool bear_ready = lock_active_sig ? ((not in_bear_race) and ((bar_index - last_bear_exit_bar) >= min_sig_gap)) : ((bar_index - last_bear_sig_bar) >= min_sig_gap)

bool raw_bull = (bull_t1_cond or bull_t2_cond) and (bar_index > 260) and bull_ready
if raw_bull
    last_bull_sig_bar := bar_index
    in_bear_race := false
    if not in_bull_race
        in_bull_race := true
        bull_px := close
        bull_yr := year(time)

bool raw_bear = (bear_t1_cond or bear_t2_cond) and (bar_index > 260) and bear_ready
if raw_bear
    last_bear_sig_bar := bar_index
    in_bull_race := false
    if not in_bear_race
        in_bear_race := true
        bear_px := close
        bear_yr := year(time)

bool sig_bull_t1   = raw_bull and bull_t1_cond
bool sig_bull_t2   = raw_bull and (not bull_t1_cond) and (tier2a_deep_bull or tier2b_ovn_flow or arch5a_sma200_reclaim)
bool sig_bull_vbot = raw_bull and (not bull_t1_cond) and (not sig_bull_t2) and tier2c_vbottom

bool sig_bear_t1   = raw_bear and bear_t1_cond
bool sig_bear_t2   = raw_bear and (not bear_t1_cond)

// ============================================================================
// 6. PLOTS, SHAPES, BGCOLOR, ALERTS & DUAL TELEMETRY DASHBOARD
// ============================================================================
plot(sma200, "SMA 200 (Secular Regime)", color=color.new(#38bdf8, 35), linewidth=2)
plot(ema20,  "EMA 20 (Cycle Equilibrium)", color=color.new(#94a3b8, 50), linewidth=1)

// Bullish (+5%) Markers Below Bar
plotshape(sig_bull_t1,   title="Bull Tier 1 Sniper (+5%)",       style=shape.triangleup,   location=location.belowbar, color=color.new(#22c55e, 0), size=size.small, text="+5% T1")
plotshape(sig_bull_t2,   title="Bull Tier 2 High-Capture (+5%)", style=shape.diamond,      location=location.belowbar, color=color.new(#f59e0b, 0), size=size.small, text="+5% T2")
plotshape(sig_bull_vbot, title="Bull Tier 2C V-Bottom (<SMA200)",style=shape.triangleup,   location=location.belowbar, color=color.new(#06b6d4, 0), size=size.small, text="+5% VBot")

// Bearish (-5%) Markers Above Bar
plotshape(sig_bear_t1,   title="Bear Tier 1 Sniper (-5% Drop)",  style=shape.triangledown, location=location.abovebar, color=color.new(#ef4444, 0), size=size.small, text="-5% B1")
plotshape(sig_bear_t2,   title="Bear Tier 2 High-Cap (-5% Drop)",style=shape.triangledown, location=location.abovebar, color=color.new(#fb7185, 0), size=size.tiny,  text="-5% B2")

bgcolor(raw_bull ? color.new(#22c55e, 88) : raw_bear ? color.new(#ef4444, 88) : na, title="Dual Signal Highlight")
barcolor(sig_bull_t1 ? #22c55e : sig_bear_t1 ? #ef4444 : sig_bull_vbot ? #06b6d4 : sig_bull_t2 ? #f59e0b : sig_bear_t2 ? #fb7185 : na, title="Signal Bar Color")

alertcondition(raw_bull, title="Bullish Early >=+5% Signal", message="Bullish +5% Engine fired on {{ticker}} at {{close}}")
alertcondition(raw_bear, title="Bearish Early >=-5% Drop Signal", message="Bearish -5% Drop Engine fired on {{ticker}} at {{close}}")

var table dash = table.new(position.top_right, 2, 7, bgcolor=color.new(#0f172a, 10), border_color=color.new(#334155, 30), border_width=1)
if barstate.islast
    float b_is_wr  = b_is_n > 0  ? (b_is_w * 100.0 / b_is_n)   : 0.0
    float b_oos_wr = b_oos_n > 0 ? (b_oos_w * 100.0 / b_oos_n) : 0.0
    float b_all_wr = (b_is_n + b_oos_n) > 0 ? ((b_is_w + b_oos_w) * 100.0 / (b_is_n + b_oos_n)) : 0.0

    float s_is_wr  = s_is_n > 0  ? (s_is_w * 100.0 / s_is_n)   : 0.0
    float s_oos_wr = s_oos_n > 0 ? (s_oos_w * 100.0 / s_oos_n) : 0.0
    float s_all_wr = (s_is_n + s_oos_n) > 0 ? ((s_is_w + s_oos_w) * 100.0 / (s_is_n + s_oos_n)) : 0.0

    table.cell(dash, 0, 0, "JANUS-5 Dual Sniper", text_color=color.white, bgcolor=color.new(#1e293b, 0), text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker + " [Bull +5% | Bear -5%]", text_color=#38bdf8, bgcolor=color.new(#1e293b, 0), text_size=size.small)

    table.cell(dash, 0, 1, "Bull (+5%) IS WR (<" + str.tostring(oos_split_year) + ")", text_color=#cbd5e1, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(b_is_wr, "#.1") + "% (" + str.tostring(b_is_w) + "/" + str.tostring(b_is_n) + ")", text_color=#22c55e, text_size=size.small)

    table.cell(dash, 0, 2, "Bull (+5%) OOS WR (>=" + str.tostring(oos_split_year) + ")", text_color=#cbd5e1, text_size=size.small)
    table.cell(dash, 1, 2, str.tostring(b_oos_wr, "#.1") + "% (" + str.tostring(b_oos_w) + "/" + str.tostring(b_oos_n) + ")", text_color=#34d399, text_size=size.small)

    table.cell(dash, 0, 3, "Bull (+5%) Full WR", text_color=#cbd5e1, text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(b_all_wr, "#.1") + "%", text_color=#22c55e, text_size=size.small)

    table.cell(dash, 0, 4, "Bear (-5%) IS WR (<" + str.tostring(oos_split_year) + ")", text_color=#cbd5e1, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(s_is_wr, "#.1") + "% (" + str.tostring(s_is_w) + "/" + str.tostring(s_is_n) + ")", text_color=#f87171, text_size=size.small)

    table.cell(dash, 0, 5, "Bear (-5%) OOS WR (>=" + str.tostring(oos_split_year) + ")", text_color=#cbd5e1, text_size=size.small)
    table.cell(dash, 1, 5, str.tostring(s_oos_wr, "#.1") + "% (" + str.tostring(s_oos_w) + "/" + str.tostring(s_oos_n) + ")", text_color=#fb7185, text_size=size.small)

    table.cell(dash, 0, 6, "Bear (-5%) Full WR", text_color=#cbd5e1, text_size=size.small)
    table.cell(dash, 1, 6, str.tostring(s_all_wr, "#.1") + "%", text_color=#ef4444, text_size=size.small)
